OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
WEAVIATE_API_KEY=
WEAVIATE_URL=
COHERE_API_KEY=

# SEC requires a descriptive User-Agent with contact info on EDGAR API requests:
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=Agentic-Document-Searcher research@example.com

# Agent LLMs (src/agent). AGENT_LLM_MODEL drives every step by default.
# AGENT_GRADE_MODEL optionally overrides it for grade/reformulate; leave unset.
# gpt-5.4-mini was tried as the grader and approved partial/wrong-year context
# on multi-part questions that gpt-5.4 correctly rejected.
AGENT_LLM_MODEL=gpt-5.4
