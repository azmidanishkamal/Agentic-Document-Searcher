OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
WEAVIATE_API_KEY=
WEAVIATE_URL=
COHERE_API_KEY=

# SEC requires a descriptive User-Agent with contact info on EDGAR API requests:
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT=Agentic-Document-Searcher research@example.com

# Agent LLMs (src/agent). AGENT_LLM_MODEL drives answer generation; the optional
# AGENT_GRADE_MODEL overrides it for the lightweight grade/reformulate steps.
AGENT_LLM_MODEL=gpt-5.4
AGENT_GRADE_MODEL=gpt-5.4-mini
